# PCBGenius — Clean vLLM OpenAI-compatible HTTP image
FROM vllm/vllm-openai:latest
EXPOSE 8000
ENTRYPOINT ["vllm", "serve", "QuantTrio/Qwen3-VL-32B-Instruct-AWQ", \
     "--port", "8000", \
     "--host", "0.0.0.0", \
     "--dtype", "float16", \
     "--quantization", "awq", \
     "--max-model-len", "4096", \
     "--trust-remote-code"]
